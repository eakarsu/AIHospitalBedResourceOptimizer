# Copy to .env and supply local values. Never commit .env.
NODE_ENV=development
JWT_SECRET=
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_optimizer
DB_USER=
DB_PASSWORD=
BACKEND_PORT=3001
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false

ADT_FHIR_BASE_URL=
BED_MANAGEMENT_BASE_URL=
STAFFING_BASE_URL=
EVS_BASE_URL=
TRANSPORT_BASE_URL=
COMMAND_CENTER_BASE_URL=
SOURCE_STALE_AFTER_SECONDS=60
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
